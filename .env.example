# Public project identifier from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Use a PUBLIC dataset: the website reads published content without a token.
NEXT_PUBLIC_SANITY_DATASET=production
# Local seed script only. Use an Editor token; never prefix this with NEXT_PUBLIC_.
SANITY_API_TOKEN=

# Standalone Studio build: use the same values as NEXT_PUBLIC_SANITY_* above.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Public site settings. Change SITE_URL and redeploy when connecting the custom domain.
NEXT_PUBLIC_SITE_URL=https://insignia-lumikai.vercel.app
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-FBKLWYJ4WZ
# Optional Google Search Console HTML verification token (not a service-account key).
GOOGLE_SITE_VERIFICATION=
