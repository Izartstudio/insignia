{
  "name": "insignia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sanity:import-gallery": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/import-spatial-gallery.mjs",
    "inspect:model": "node scripts/inspect-model.mjs",
    "sanity": "node --env-file-if-exists=.env.local node_modules/sanity/bin/sanity",
    "sanity:seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/import-spatial-gallery.mjs",
    "test": "node --test scripts/*.test.cjs",
    "check:production": "node scripts/check-production.mjs",
    "sanity:sync-design": "node --env-file-if-exists=.env.local scripts/sync-gallery-design.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@sanity/client": "^8.10.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "lottie-web": "^5.13.0",
    "next": "16.4.3",
    "next-sanity": "^13.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanity": "^6.20.0",
    "styled-components": "^6.1.15",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "js-yaml@<3.15.2": "3.15.2",
    "smol-toml@<1.9.1": "1.9.1",
    "undici@>=7.0.0 <7.30.1": "7.30.1",
    "uuid@10.0.0": "11.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
